PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/bulkbridge
CLIENT_URL=http://localhost:5174
JWT_SECRET=replace-with-a-long-random-secret

# Password reset email (optional for local development)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
MAIL_FROM=your-email@gmail.com

# When SMTP is not configured, local development can show a one-time reset URL in the UI.
# Keep this false in production.
DEV_RESET_MODE=true
NODE_ENV=development

# Used only by POST /api/users/admin/bootstrap to create the first admin account.
ADMIN_BOOTSTRAP_KEY=replace-with-a-random-bootstrap-key
